# Google Gemini API Key (Required for speech-to-intent and JSON extraction)
GOOGLE_API_KEY=your_gemini_api_key_here

# Resend API Key (For sending owner order cards and balance due receipts)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev

# TextBee SMS Gateway (For dispatching SMS deadline alerts to owner's phone)
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=

# Next.js Frontend Configuration (Used during Vercel deployment)
# Set to your deployed backend URL (e.g. Render, Railway, or Google Cloud Run)
NEXT_PUBLIC_API_URL=http://localhost:8000

